<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rime Sync Scheduler"
        android:textSize="20sp"
        android:textColor="#1A1A1A"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="fcitx5-android · local &amp; cloud"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginBottom="12dp" />

    <!-- Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textSize="12sp"
        android:textColor="#555555"
        android:gravity="start"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:minHeight="40dp"
        android:layout_marginBottom="10dp" />

    <!-- Sync dirs display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sync Paths"
            android:textSize="13sp"
            android:textColor="#333333"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Local rime dir (read-only) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="8dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rime:"
            android:textSize="13sp"
            android:textColor="#388E3C"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvRimeDir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="..."
            android:textSize="11sp"
            android:textColor="#555555"
            android:singleLine="true"
            android:ellipsize="middle" />
    </LinearLayout>

    <!-- Local sync dir (read-only, from installation.yaml sync_dir) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="8dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sync:"
            android:textSize="13sp"
            android:textColor="#FF9800"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvSyncDir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="..."
            android:textSize="11sp"
            android:textColor="#555555"
            android:singleLine="true"
            android:ellipsize="middle" />
    </LinearLayout>

    <!-- Remote path + browse -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remote:"
            android:textSize="13sp"
            android:textColor="#1976D2"
            android:layout_marginEnd="6dp" />

        <EditText
            android:id="@+id/etRemotePath"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="rime/"
            android:textSize="12sp"
            android:inputType="textUri"
            android:singleLine="true"
            android:padding="4dp"
            android:background="@null" />
    </LinearLayout>

    <!-- Action buttons -->
    <Button
        android:id="@+id/btnLocalSync"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Local Sync"
        android:textSize="15sp"
        android:layout_marginBottom="6dp"
        android:backgroundTint="#4CAF50" />

    <Button
        android:id="@+id/btnCloudSync"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cloud Sync"
        android:textSize="15sp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#2196F3" />

    <!-- rclone.conf section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="rclone.conf"
            android:textSize="13sp"
            android:textColor="#333333"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnImportConfig"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Import"
            android:textSize="11sp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:backgroundTint="#FF9800" />

        <Button
            android:id="@+id/btnSaveConfig"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Save"
            android:textSize="11sp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#9E9E9E" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRemotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:textColor="#666666"
        android:gravity="start"
        android:layout_marginBottom="2dp" />

    <!-- Config editor -->
    <EditText
        android:id="@+id/etConfig"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text=""
        android:textSize="11sp"
        android:inputType="textMultiLine|textNoSuggestions"
        android:gravity="top"
        android:padding="6dp"
        android:background="#FFFFFF"
        android:typeface="monospace"
        android:hint="rclone config here..." />

</LinearLayout>
