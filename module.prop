id=rime-sync-scheduler
name=Rime Sync Scheduler
version=v2.0
versionCode=3
author=fcitx5-android user
description=Rime local + cloud sync scheduler for fcitx5-android. \n\
  Config lives in fcitx5's data dir (written by hook). \n\
  Manual sync: am broadcast -a org.fcitx.fcitx5.android.action.TRIGGER_RIME_SYNC \n\
  Cloud sync: sh /data/adb/modules/rime-sync-scheduler/backup.sh --full-sync
